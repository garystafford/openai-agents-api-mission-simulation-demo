{
  "name": "mars-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "eval": "tsx evals/run.ts",
    "test:security": "node --import tsx --test evals/access.test.ts",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --import tsx --test evals/agents-api.test.ts evals/mission-api.test.ts evals/mission-sessions.test.ts evals/simulation.test.ts evals/telemetry.test.ts evals/release.test.ts evals/benchmark.test.ts evals/mission-client.test.ts evals/execution-clock.test.ts evals/simulation-time.test.ts evals/mission-events.test.ts evals/mission-evidence.test.ts evals/incident-variation.test.ts evals/replanning.test.ts",
    "benchmark": "tsx evals/benchmark.ts",
    "test:browser": "playwright test",
    "eval:collect": "tsx evals/promptfoo/collect.ts",
    "eval:dataset:build": "tsx evals/promptfoo/build-dataset.ts",
    "eval:dataset:verify": "tsx evals/promptfoo/verify.ts",
    "eval:plan": "tsx evals/promptfoo/plan.ts",
    "eval:models": "tsx evals/promptfoo/run.ts",
    "test:evals": "node --import tsx --test evals/promptfoo/*.test.ts",
    "check:evals": "tsc -p evals/promptfoo/tsconfig.json",
    "eval:config:verify": "tsx evals/promptfoo/validate-config.ts",
    "eval:references": "tsx evals/promptfoo/references.ts",
    "eval:references:review": "tsx evals/promptfoo/review-references.ts",
    "eval:calibrate:offline": "tsx evals/promptfoo/offline-review.ts",
    "eval:judge:calibrate": "tsx evals/promptfoo/run-judge-calibration.ts",
    "eval:judge:report": "tsx evals/promptfoo/report-judge-calibration.ts",
    "eval:judge": "tsx evals/promptfoo/run-judge-calibration.ts",
    "eval:team:validate": "tsx evals/promptfoo/run-team-validation.ts",
    "eval:team:report": "tsx evals/promptfoo/report-validation.ts",
    "eval:focused": "tsx evals/promptfoo/run-focused.ts",
    "eval:focused:report": "tsx evals/promptfoo/report-focused.ts"
  },
  "dependencies": {
    "@arizeai/phoenix-otel": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "openai": "^7.23.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "promptfoo": "0.123.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.3.5"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.1"
    }
  }
}
