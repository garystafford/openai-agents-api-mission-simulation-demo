# Required to run the mission team assessment.
OPENAI_API_KEY=

# Local access by default. Restart the server after changing access settings.
HOST=127.0.0.1
PORT=3001

# Required for a non-loopback HOST: a random password of at least 12 characters.
# Browser sign-in username: commander. Never use your OpenAI API key here.
MISSION_ACCESS_PASSWORD=

# Comma-separated exact origins, without trailing slashes. Network access requires HTTPS.
# Local defaults allow localhost, 127.0.0.1, and [::1] on PORT and Vite port 5173.
MISSION_ALLOWED_ORIGINS=

# Agent runtime profiles. Restart the server after changing these values.
MISSION_DIRECTOR_MODEL=gpt-6-luna
MISSION_DIRECTOR_REASONING_EFFORT=medium
POWER_THERMAL_MODEL=gpt-6-astra
POWER_THERMAL_REASONING_EFFORT=medium
LIFE_SUPPORT_MODEL=gpt-6-luna
LIFE_SUPPORT_REASONING_EFFORT=medium
WEATHER_NAVIGATION_MODEL=gpt-6-luna
WEATHER_NAVIGATION_REASONING_EFFORT=medium
RISK_REVIEW_MODEL=gpt-6-astra
RISK_REVIEW_REASONING_EFFORT=medium

# Optional mission-cost pricing overrides. The app has standard direct-API rates for its
# default models; use this JSON object for a different model, service tier, region, or provider.
# Values are USD per 1M tokens: {"model":{"input":0,"cachedInput":0,"output":0}}
MISSION_COST_PRICING_OVERRIDES=

# Optional Arize Phoenix tracing.
PHOENIX_ENABLED=false
PHOENIX_PROJECT_NAME=mars-mission-control
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Durable private state, outside the public client directory. One server process per directory.
MISSION_DATA_DIR=.mission-data

# Per-assessment wall time and shared parallel-work limits; token/cost totals are per mission.
MISSION_INVESTIGATION_SECONDS=240
# Bound each specialist independently, leaving time for Director synthesis; no automatic retry.
MISSION_SPECIALIST_SECONDS=120
# Independent remote stop confirmation window (positive, at most 60 seconds).
MISSION_CANCELLATION_SECONDS=15
MISSION_MAX_CONSULTATIONS=12
MISSION_MAX_FUNCTION_CALLS=64
MISSION_MAX_VALIDATION_RETRIES=3
MISSION_MAX_TOKENS=500000
# Observed estimate guard; delayed provider accounting can overshoot this value.
MISSION_MAX_ESTIMATED_COST_USD=2

# Explicit live benchmark only; makes paid API calls and auto-authorizes simulated actions.
BENCHMARK_REPEATS=1
BENCHMARK_CONCURRENCY=2
BENCHMARK_MAX_ESTIMATED_COST_USD=3
